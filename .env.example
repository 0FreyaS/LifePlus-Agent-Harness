APP_MODE=local
# For a private interview deployment: APP_MODE=showcase. Never commit real credentials.
SHOWCASE_USERNAME=interviewer
SHOWCASE_PASSWORD=
PUBLIC_ORIGIN=
SHOWCASE_ALLOW_HTTP=false
# Optional Docker HTTPS deployment:
LIFEPLUS_DOMAIN=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=
DEFAULT_CURRENT_LOCATION=江苏省无锡市滨湖区东南大学无锡校区
DEFAULT_CURRENT_CITY=无锡市
DATABASE_PATH=./data/lifeplus.sqlite3
# Production backends. Leave empty to use local SQLite/in-process fallbacks.
CHECKPOINT_POSTGRES_DSN=
REDIS_URL=
MYSQL_DSN=
CHROMA_PATH=./data/chroma
TOOL_QUEUE_WORKERS=4
TOOL_QUEUE_TIMEOUT_SECONDS=8
TOOL_QUEUE_MAX_RETRIES=2
# Per-task cumulative work caps; waiting for the user is excluded.
RUNTIME_ACTIVE_SECONDS=120
RUNTIME_PLANNING_SECONDS=45
INPUT_EVENT_TIMEOUT_SECONDS=25
RUNTIME_MODEL_CALLS=8
RUNTIME_TOOL_CALLS=24
RUNTIME_RESUMES=8
RUNTIME_REFRESHES=5
RUNTIME_RETRIES=3
RUNTIME_GRAPH_STEPS=64
# Model SDK retries are disabled; JSON/schema repair permits only one extra attempt.
MODEL_MAX_OUTPUT_TOKENS=2048
# Keep baseline unless a paired real-model A/B report passes the rollout gate.
PLANNER_VARIANT=baseline
PLANNER_MAX_OUTPUT_TOKENS=1536
# Optional role overrides; blank names reuse MODEL_NAME, URL and credentials.
PLANNER_MODEL_NAME=
INTENT_MODEL_NAME=
RESPONSE_MODEL_NAME=
# Optional INTENT_MAX_OUTPUT_TOKENS / RESPONSE_MAX_OUTPUT_TOKENS reuse the global cap when unset.
MAX_ACTIVE_TASKS_PER_USER=8
MEMORY_HISTORY_MESSAGES=12
MEMORY_HISTORY_CHARACTERS=12000
# Application freshness limits, not provider truth or production SLA guarantees.
FRESHNESS_CONTEXT_SECONDS=1800
FRESHNESS_SELECTION_SECONDS=300
FRESHNESS_APPROVAL_SECONDS=120
FRESHNESS_CLARIFICATION_SECONDS=1800
FRESHNESS_WEATHER_SECONDS=300
FRESHNESS_PLACES_SECONDS=300
FRESHNESS_ROUTE_SECONDS=120
FRESHNESS_MUSIC_SECONDS=1800
MODEL_BASE_URL=https://api.x.ai/v1
MODEL_API_KEY=
MODEL_NAME=
AMAP_MAPS_API_KEY=
OLD_INTENT_URL=
OLD_REJECT_URL=
DEMO_USER_ID=demo-user
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175
